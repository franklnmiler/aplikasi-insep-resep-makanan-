<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@drawable/orange_gradient_background">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="32dp">

        <!-- User ID -->
        <TextView
            android:id="@+id/tv_user_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="User ID: uid123"
            android:layout_marginBottom="8dp"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="@android:color/darker_gray" />

        <!-- Recipe Name -->
        <EditText
            android:id="@+id/et_recipe_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nama Resep"
            android:inputType="textCapWords"
            android:minHeight="48dp"
            android:layout_marginBottom="12dp"
            android:background="@android:drawable/editbox_background_normal"
            android:padding="12dp" />

        <!-- Description -->
        <EditText
            android:id="@+id/et_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Deskripsi"
            android:inputType="textCapSentences"
            android:minHeight="48dp"
            android:layout_marginBottom="12dp"
            android:background="@android:drawable/editbox_background_normal"
            android:padding="12dp" />

        <!-- Category -->
        <Spinner
            android:id="@+id/spinner_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginBottom="12dp" />

        <!-- Ingredients -->
        <EditText
            android:id="@+id/et_ingredients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Bahan-bahan"
            android:inputType="textMultiLine"
            android:minHeight="100dp"
            android:gravity="top"
            android:layout_marginBottom="12dp"
            android:background="@android:drawable/editbox_background_normal"
            android:padding="12dp" />

        <!-- Steps -->
        <EditText
            android:id="@+id/et_steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Langkah-langkah"
            android:inputType="textMultiLine"
            android:minHeight="100dp"
            android:gravity="top"
            android:layout_marginBottom="12dp"
            android:background="@android:drawable/editbox_background_normal"
            android:padding="12dp" />

        <!-- Video URL -->
        <EditText
            android:id="@+id/et_video_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="URL Video (Opsional)"
            android:inputType="textUri"
            android:minHeight="48dp"
            android:layout_marginBottom="12dp"
            android:background="@android:drawable/editbox_background_normal"
            android:padding="12dp" />

        <!-- Image Preview -->
        <ImageView
            android:id="@+id/image_preview"
            android:layout_width="match_parent"
            android:layout_height="247dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:background="@android:color/darker_gray"
            android:contentDescription="Pratinjau Gambar Resep"
            android:scaleType="centerCrop" />

        <!-- Choose Image Button -->
        <Button
            android:id="@+id/btn_ganti_image"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pilih Gambar"
            android:minHeight="48dp"
            android:layout_marginBottom="12dp" />

        <!-- Save Button -->
        <Button
            android:id="@+id/btn_save_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Simpan Resep"
            android:minHeight="48dp"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>
