<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF6E8">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/orange_gradient_background">

                <!-- Gambar + FAB Favorit -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="32dp">

                    <!-- Gambar Resep -->
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/img_recipe"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:scaleType="centerCrop"
                        android:src="@drawable/talasbogor"
                        app:shapeAppearanceOverlay="@style/RoundedCornerImage" />

                    <!-- FAB Favorit -->
                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/fab_favorite"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignEnd="@id/img_recipe"
                        android:layout_below="@id/img_recipe"
                        android:layout_marginTop="-28dp"
                        android:layout_marginEnd="16dp"
                        android:elevation="6dp"
                        android:src="@drawable/ic_favorit"
                        app:backgroundTint="@color/red"
                        app:tint="@android:color/white" />

                    <!-- Jumlah Favorit -->
                    <TextView
                        android:id="@+id/tv_favorite_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignEnd="@id/fab_favorite"
                        android:layout_above="@id/fab_favorite"
                        android:layout_marginEnd="1dp"
                        android:layout_marginBottom="20dp"
                        android:text="0"
                        android:textSize="14sp"
                        android:background="@drawable/bg_white_rounded"
                        android:textColor="#000"
                        android:padding="4dp"
                        android:elevation="2dp"
                        android:gravity="center" />

                </RelativeLayout>

                <!-- Judul -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pumpkin Soup"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:layout_marginTop="8dp" />

                <!-- Author -->
                <TextView
                    android:id="@+id/tv_author"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="by: Admin"
                    android:textSize="14sp"
                    android:textColor="#888888"
                    android:layout_marginTop="4dp" />

                <!-- Kategori -->
                <TextView
                    android:id="@+id/tv_category"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Kategori: Makanan"
                    android:textSize="14sp"
                    android:textColor="#888888"
                    android:layout_marginTop="2dp" />

                <!-- Deskripsi -->
                <TextView
                    android:id="@+id/tv_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Deskripsi resep..."
                    android:textSize="15sp"
                    android:textColor="#444444"
                    android:layout_marginTop="12dp" />

                <!-- Bahan-bahan -->
                <TextView
                    android:id="@+id/tv_ingredients"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bahan-Bahan:"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp" />

                <TextView
                    android:id="@+id/tv_ingredients_list1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="- 250 gram talas Bogor..."
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />

                <!-- Langkah-langkah -->
                <TextView
                    android:id="@+id/tv_steps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Langkah-Langkah Membuat:"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp" />

                <TextView
                    android:id="@+id/tv_steps_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=".."
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />

                <!-- Video -->
                <TextView
                    android:id="@+id/detail_video_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="https://youtube.com/contohvideo"
                    android:autoLink="web"
                    android:textColor="@android:color/holo_blue_dark"
                    android:layout_marginTop="16dp" />

                <!-- Tombol Share -->
                <Button
                    android:id="@+id/btn_share"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bagikan Resep"
                    android:layout_marginTop="16dp" />

                <!-- Komentar -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Komentar:"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginTop="24dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edit_text_comment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Tulis komentar..."
                        android:minLines="1"
                        android:maxLines="4"
                        android:inputType="textMultiLine" />
                </com.google.android.material.textfield.TextInputLayout>

                <Button
                    android:id="@+id/btn_add_comment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kirim Komentar"
                    android:layout_marginTop="8dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_view_comments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
