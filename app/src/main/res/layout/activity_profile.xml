<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".YourActivity">


    <View
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:background="@drawable/gradient_background"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ScrollView for all content -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavigationView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Profile Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#E0E0E0"
                app:strokeWidth="1dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:gravity="center_horizontal">

                    <!-- Avatar with circular shape -->
                    <ImageView
                        android:id="@+id/profile_image"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:src="@drawable/ic_eye"
                        android:layout_marginBottom="8dp"
                        android:scaleType="centerCrop"
                        android:background="@drawable/circle_background"
                        android:clipToOutline="true" />

                    <!-- Name -->
                    <EditText
                        android:id="@+id/edit_username"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Becca William"
                        android:textSize="20sp"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@null"
                        android:inputType="textPersonName"
                        android:layout_marginBottom="16dp"/>

                    <!-- Info Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        android:layout_marginTop="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <!-- Email -->
                            <TextView
                                android:text="Email"
                                android:textStyle="bold"
                                android:textColor="#888888"
                                android:textSize="12sp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                            <TextView
                                android:id="@+id/text_email"
                                android:text="Beccaw@gmail.com"
                                android:textColor="#000000"
                                android:textSize="14sp"
                                android:layout_marginBottom="16dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                            <!-- Password -->
                            <TextView
                                android:text="Password"
                                android:textStyle="bold"
                                android:textColor="#888888"
                                android:textSize="12sp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                            <EditText
                                android:id="@+id/edit_password"
                                android:text="becca_w"
                                android:textColor="#000000"
                                android:textSize="14sp"
                                android:layout_marginBottom="16dp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textPassword"/>

                            <!-- Phone -->
                            <TextView
                                android:text="Phone"
                                android:textStyle="bold"
                                android:textColor="#888888"
                                android:textSize="12sp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                            <EditText
                                android:id="@+id/edit_phone"
                                android:text="08999988877"
                                android:textColor="#000000"
                                android:textSize="14sp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="phone"/>

                            <!-- Save Button -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_save"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginTop="16dp"
                                android:backgroundTint="#4CAF50"
                                android:text="Save"
                                android:textColor="@android:color/white"
                                android:textStyle="bold"
                                app:cornerRadius="8dp"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Settings Title -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="Pengaturan"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@android:color/black" />

            <!-- Menu List -->
            <LinearLayout
                android:id="@+id/menuList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <!-- Verification -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#E0E0E0"
                    app:strokeWidth="1dp"
                    android:backgroundTint="#FFF6F6">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_eye"
                            android:id="@+id/iconVerification"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:tint="#555555"/>

                        <Button
                            android:id="@+id/itemVerification"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/iconVerification"
                            android:layout_marginStart="16dp"
                            android:background="@android:color/transparent"
                            android:text="Verifikasi Data Diri"
                            android:textSize="16sp"
                            android:textColor="@android:color/black"
                            android:gravity="start|center_vertical"
                            android:padding="0dp" />

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/panah"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:tint="#888888"/>
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- History -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#E0E0E0"
                    app:strokeWidth="1dp"
                    android:backgroundTint="#FFF6F6">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_eye"
                            android:id="@+id/iconRiwayat"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:tint="#555555"/>

                        <Button
                            android:id="@+id/itemRiwayat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/iconRiwayat"
                            android:layout_marginStart="16dp"
                            android:background="@android:color/transparent"
                            android:text="Riwayat"
                            android:textSize="16sp"
                            android:textColor="@android:color/black"
                            android:gravity="start|center_vertical"
                            android:padding="0dp" />

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/panah"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:tint="#888888"/>
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Favorites -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#E0E0E0"
                    app:strokeWidth="1dp"
                    android:backgroundTint="#FFF6F6">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_eye"
                            android:id="@+id/iconFavorit"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:tint="#555555"/>

                        <Button
                            android:id="@+id/itemFavorit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/iconFavorit"
                            android:layout_marginStart="16dp"
                            android:background="@android:color/transparent"
                            android:text="Favorit"
                            android:textSize="16sp"
                            android:textColor="@android:color/black"
                            android:gravity="start|center_vertical"
                            android:padding="0dp" />

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/panah"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:tint="#888888"/>
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Help -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#E0E0E0"
                    app:strokeWidth="1dp"
                    android:backgroundTint="#FFF6F6">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_eye"
                            android:id="@+id/iconBantuan"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:tint="#555555"/>

                        <Button
                            android:id="@+id/itemBantuan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/iconBantuan"
                            android:layout_marginStart="16dp"
                            android:background="@android:color/transparent"
                            android:text="Bantuan"
                            android:textSize="16sp"
                            android:textColor="@android:color/black"
                            android:gravity="start|center_vertical"
                            android:padding="0dp" />

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/panah"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:tint="#888888"/>
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Follow Me Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_request"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#00BCD4"
                android:text="FOLLOW ME"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                app:cornerRadius="8dp"/>

            <!-- Logout and Help Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_logout"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:backgroundTint="#FB3F3F"
                    android:text="Logout"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    app:cornerRadius="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_help"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="#4CAF50"
                    android:text="Help Me"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    app:cornerRadius="8dp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        app:itemIconTint="@drawable/bottom_nav_colors"
        app:itemTextColor="@drawable/bottom_nav_colors"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:elevation="8dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>